# Ada, the tutor, is optional — the app degrades to rule-based explanations
# derived from the model's own outputs when these are unset.
#
# Set in the Vercel project's Environment Variables, never in the repo.
OPENAI_API_KEY=sk-...

# Optional. Defaults to gpt-5-mini. Use gpt-5-nano to cut cost roughly 5x.
OPENAI_MODEL=gpt-5-mini
